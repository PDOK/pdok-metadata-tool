<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>NGR connection and load tests - overview</title>
<meta name="viewport" content="width=device-width, initial-scale=1">
<style>{{template "css"}}
.page[hidden] { display:none; }
.back { display:inline-block; margin:16px 40px 0; color:var(--accent); text-decoration:none; }
a { color:var(--accent); text-decoration:none; } a:hover { text-decoration:underline; }
.bars2 { background:var(--card); border:1px solid var(--line); border-radius:10px; padding:12px 16px; }
.bars2 .row { display:grid; grid-template-columns:340px 1fr; gap:10px; align-items:center; margin:6px 0; }
.bars2 .bar { height:12px; border-radius:3px; margin:2px 0; min-width:2px; position:relative; }
.bars2 .bar span { position:absolute; left:calc(100% + 6px); top:-3px; font-size:11px; color:var(--muted); white-space:nowrap; }
.findings { display:grid; gap:12px; }
.matrix td, .matrix th { text-align:center; vertical-align:top; }
.matrix td:first-child, .matrix th:first-child { text-align:left; }
.matrix .sub { color:var(--muted); font-size:11px; display:block; }
.tag { font-size:11px; color:var(--muted); border:1px solid var(--line); border-radius:99px; padding:0 7px; margin-left:6px; }
.lead { color:var(--muted); max-width:900px; }
</style>
</head>
<body>
<section class="page" id="overview">
<header>
  <h1>NGR connection and load tests &middot; overview</h1>
  <div class="sub">{{len .Rows}} runs &middot; {{.TotalReqs}} requests in total &middot; {{.TotalFailed}} failed &middot; generated {{datetime .Generated}}</div>
</header>
<main>

<h2>What did we test?</h2>
<p class="lead">The INSPIRE validator sometimes fails when it talks to the NGR (Nationaal Georegister) since NGR moved to a new hosting provider. These tests try to find out why. Two kinds of tests were run, from different places (laptop, test cluster):</p>
<ul class="lead">
  <li><b>Connection tests</b>: open many brand new connections to NGR and to neutral <i>control</i> websites and check whether every connection succeeds. This shows whether the problem is NGR or our own network path.</li>
  <li><b>CSW load tests</b>: replay the requests the INSPIRE validator sends to the NGR CSW for all PDOK services, with and without connection reuse (keep-alive). This shows how the CSW behaves under realistic load.</li>
</ul>
{{template "glossary"}}

{{if .Findings}}
<h2>Key findings</h2>
<div class="findings">
{{range .Findings}}<div class="verdict {{.Level}}"><div class="title">{{.Title}}</div><div>{{.Text}}</div></div>{{end}}
</div>
<p class="note">Findings are computed from all runs below and are indications, not proof; compare the numbers on the detail pages.</p>
{{end}}

{{if .ConnRows}}
<h2>Connection tests: new connections per target</h2>
<p class="lead">Every cell is one connection test: how many of the new connections failed, and how long setting up a connection (DNS, TCP, TLS) took on average. <b>Control</b> targets are neutral websites. If they never fail while NGR does, the problem is on the NGR side and not in our network.</p>
<div class="scroll"><table class="matrix">
<thead><tr><th>Target</th>{{range .Matrix.Origins}}<th>From {{.}}</th>{{end}}</tr></thead>
<tbody>{{range .Matrix.Rows}}<tr><td>{{.Suite}}{{if .Control}}<span class="tag">control</span>{{else}}<span class="tag">NGR</span>{{end}}<span class="sub mono">{{.Target}}</span></td>
{{range .Cells}}<td>{{if .Has}}<a href="#run-{{.Index}}"><span class="status {{rateClass .ErrorRate}}">{{pct .ErrorRate}} failed</span></a>
<span class="sub">{{.Errors}} of {{.Count}} &middot; setup {{ms .SetupMs}} &middot; p99 {{ms .P99Ms}}</span>{{else}}<span class="sub">not run</span>{{end}}</td>{{end}}</tr>{{end}}</tbody>
</table></div>
<p class="note">If a target was tested more than once from the same place, the latest run is shown. Click a cell for the detail page.</p>

<h2>Connection test runs</h2>
<div class="scroll"><table>
<thead><tr><th>#</th><th class="l">Status</th><th class="l">Target</th><th class="l">From</th><th class="l">Started</th><th class="l">WAN IP</th><th>Workers</th><th>Connections</th><th>Failed</th><th>Error rate</th><th>Avg</th><th>p99</th></tr></thead>
<tbody>{{range .ConnRows}}<tr>
<td>{{.Index}}</td><td class="l"><span class="status {{.Verdict.Level}}">{{.Verdict.Status}}</span></td><td class="l"><a href="#run-{{.Index}}">{{.Meta.Suite}}</a></td><td class="l">{{.Meta.Origin}}</td>
<td class="l">{{datetime .Meta.Started}}</td><td class="l mono">{{.Meta.WANIP}}</td><td>{{.Meta.Config.Workers}}</td><td>{{.Overall.Count}}</td><td>{{.Overall.Errors}}</td>
<td class="{{rateClass .Overall.ErrorRate}}">{{pct .Overall.ErrorRate}}</td><td>{{ms .Overall.AvgMs}}</td><td>{{ms .Overall.P99Ms}}</td></tr>{{end}}</tbody>
</table></div>

<h2>Connection tests: error rate</h2>
<div class="bars2">{{range .ConnErrors}}<div class="row"><div>{{.Label}}</div><div>
{{range .Bars}}<div class="bar" style="width:calc({{f1 .Pct}}% * 0.8);background:{{.Color}}"><span>{{.Format}}</span></div>{{end}}</div></div>{{end}}</div>

<h2>Connection tests: average response time (new connection included)</h2>
<div class="bars2">{{range .ConnLatency}}<div class="row"><div>{{.Label}}</div><div>
{{range .Bars}}<div class="bar" style="width:calc({{f1 .Pct}}% * 0.8);background:{{.Color}}"><span>{{.Format}}</span></div>{{end}}</div></div>{{end}}</div>
{{end}}

{{if .LoadRows}}
<h2>CSW load test runs</h2>
<div class="scroll"><table>
<thead><tr><th>#</th><th class="l">Status</th><th class="l">Run</th><th class="l">Started</th><th class="l">WAN IP</th><th>Workers</th><th>Iterations</th><th>Keep-alive</th><th>Requests</th><th>Failed</th><th>Error rate</th><th>Avg</th><th>p95</th><th>p99</th><th>Req/s</th></tr></thead>
<tbody>{{range .LoadRows}}<tr>
<td>{{.Index}}</td><td class="l"><span class="status {{.Verdict.Level}}">{{.Verdict.Status}}</span></td><td class="l"><a href="#run-{{.Index}}">{{.Meta.Label}}</a></td><td class="l">{{datetime .Meta.Started}}</td><td class="l mono">{{.Meta.WANIP}}</td>
<td>{{.Meta.Config.Workers}}</td><td>{{.Meta.Config.Iterations}}</td><td>{{if .Meta.Config.KeepAlive}}on{{else}}off{{end}}</td>
<td>{{.Overall.Count}}</td><td>{{.Overall.Errors}}</td><td class="{{rateClass .Overall.ErrorRate}}">{{pct .Overall.ErrorRate}}</td>
<td>{{ms .Overall.AvgMs}}</td><td>{{ms .Overall.P95Ms}}</td><td>{{ms .Overall.P99Ms}}</td><td>{{f2 .Overall.RequestsPS}}</td></tr>{{end}}</tbody>
</table></div>
<p class="note">Latency is computed over successful requests only. Click a run to see its detail page.</p>

<h2>CSW load tests: results per host</h2>
<div class="scroll"><table>
<thead><tr><th>#</th><th class="l">Run</th><th class="l">Host</th><th>Requests</th><th>Failed</th><th>Error rate</th><th>Avg</th><th>p95</th><th>p99</th><th>Max</th></tr></thead>
<tbody>{{range $r := .LoadRows}}{{range $r.Hosts}}<tr><td>{{$r.Index}}</td><td class="l"><a href="#run-{{$r.Index}}">{{$r.Meta.Label}}</a></td>
<td class="l"><span class="dot" style="background:{{color .Name}}"></span>{{.Name}}</td><td>{{.Count}}</td><td>{{.Errors}}</td>
<td class="{{rateClass .ErrorRate}}">{{pct .ErrorRate}}</td><td>{{ms .AvgMs}}</td><td>{{ms .P95Ms}}</td><td>{{ms .P99Ms}}</td><td>{{ms .MaxMs}}</td></tr>{{end}}{{end}}</tbody>
</table></div>

<h2>CSW load tests: average response time</h2>
<div class="legend">{{range .Legend}}<span><span class="dot" style="background:{{.Color}}"></span>{{.Name}}</span>{{end}}</div>
<div class="bars2">{{range .LatencyBars}}<div class="row"><div>{{.Label}}</div><div>
{{range .Bars}}<div class="bar" style="width:calc({{f1 .Pct}}% * 0.8);background:{{.Color}}"><span>{{.Format}}</span></div>{{end}}</div></div>{{end}}</div>

<h2>CSW load tests: error rate</h2>
<div class="legend">{{range .Legend}}<span><span class="dot" style="background:{{.Color}}"></span>{{.Name}}</span>{{end}}</div>
<div class="bars2">{{range .ErrorBars}}<div class="row"><div>{{.Label}}</div><div>
{{range .Bars}}<div class="bar" style="width:calc({{f1 .Pct}}% * 0.8);background:{{.Color}}"><span>{{.Format}}</span></div>{{end}}</div></div>{{end}}</div>
{{end}}
</main>
</section>
{{range .Rows}}
<section class="page" id="run-{{.Index}}" hidden>
<a class="back" href="#overview">&larr; Overview</a>
{{.Detail}}
</section>
{{end}}
<script>
(function () {
  var pages = document.querySelectorAll('.page');
  function show() {
    var id = location.hash.replace('#', '') || 'overview', found = false;
    pages.forEach(function (p) { if (p.id === id) { found = true; } });
    if (!found) { id = 'overview'; }
    pages.forEach(function (p) { p.hidden = p.id !== id; });
    window.scrollTo(0, 0);
  }
  window.addEventListener('hashchange', show);
  show();
})();
</script>
</body>
</html>
