<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>CSW load test - {{.Meta.Label}}</title>
<meta name="viewport" content="width=device-width, initial-scale=1">
<style>{{template "css"}}</style>
</head>
<body>
{{template "runbody" .}}
</body>
</html>
{{define "stats"}}
<div class="scroll"><table>
<thead><tr><th>Name</th><th>Requests</th><th>Failed</th><th>Error rate</th><th>Avg</th><th>p50</th><th>p90</th><th>p95</th><th>p99</th><th>Max</th><th>Req/s</th></tr></thead>
<tbody>{{range .}}<tr><td><span class="dot" style="background:{{color .Name}}"></span>{{.Name}}</td><td>{{.Count}}</td><td>{{.Errors}}</td>
<td class="{{rateClass .ErrorRate}}">{{pct .ErrorRate}}</td><td>{{ms .AvgMs}}</td><td>{{ms .P50Ms}}</td><td>{{ms .P90Ms}}</td><td>{{ms .P95Ms}}</td><td>{{ms .P99Ms}}</td><td>{{ms .MaxMs}}</td><td>{{f2 .RequestsPS}}</td></tr>{{end}}</tbody>
</table></div>
{{end}}
{{define "css"}}
:root { --bg:#0f1420; --card:#171e2e; --card2:#1d2639; --text:#e6ebf5; --muted:#8c98b3; --line:#2a3550;
        --good:#43d19e; --warn:#ffd166; --bad:#ff5c6c; --accent:#4f9dff; }
* { box-sizing: border-box; }
body { margin:0; background:var(--bg); color:var(--text); font:14px/1.5 system-ui,-apple-system,"Segoe UI",Roboto,sans-serif; }
header { padding:28px 40px; background:linear-gradient(135deg,#1b2a4a,#0f1420 70%); border-bottom:1px solid var(--line); }
header h1 { margin:0 0 4px; font-size:26px; }
header .sub { color:var(--muted); }
main { padding:24px 40px 60px; max-width:1300px; margin:0 auto; }
h2 { margin:36px 0 12px; font-size:18px; border-left:4px solid var(--accent); padding-left:10px; }
.grid { display:grid; gap:14px; grid-template-columns:repeat(auto-fit,minmax(190px,1fr)); }
.card { background:var(--card); border:1px solid var(--line); border-radius:10px; padding:14px 16px; }
.card .label { color:var(--muted); font-size:12px; text-transform:uppercase; letter-spacing:.06em; }
.card .value { font-size:24px; font-weight:650; margin-top:2px; word-break:break-all; }
.card .value.small { font-size:16px; }
.good { color:var(--good); } .warn { color:var(--warn); } .bad { color:var(--bad); }
table { width:100%; border-collapse:collapse; background:var(--card); border:1px solid var(--line); border-radius:10px; overflow:hidden; }
th, td { padding:7px 10px; text-align:right; border-bottom:1px solid var(--line); white-space:nowrap; }
th { background:var(--card2); color:var(--muted); font-size:12px; text-transform:uppercase; letter-spacing:.04em; }
th:first-child, td:first-child, td.l, th.l { text-align:left; }
tr:last-child td { border-bottom:none; }
tbody tr:hover { background:#1f2942; }
td.wrap { white-space:normal; word-break:break-word; max-width:420px; text-align:left; }
.scroll { overflow-x:auto; border-radius:10px; }
.dot { display:inline-block; width:10px; height:10px; border-radius:50%; margin-right:6px; }
.pill { display:inline-block; padding:1px 8px; border-radius:99px; font-size:12px; background:#3a1d28; color:var(--bad); border:1px solid #5a2a3a; }
.legend { display:flex; gap:18px; margin-bottom:8px; color:var(--muted); }
.chart { background:var(--card); border:1px solid var(--line); border-radius:10px; padding:12px; }
svg { width:100%; height:auto; display:block; }
svg .grid { stroke:var(--line); stroke-width:1; } svg .axis { fill:var(--muted); font-size:10px; }
svg .errbar { fill:var(--bad); }
.hist { background:var(--card); border:1px solid var(--line); border-radius:10px; padding:12px 16px; }
.hist .row { display:grid; grid-template-columns:110px 1fr; gap:10px; align-items:center; margin:5px 0; }
.hist .bars > div { height:12px; border-radius:3px; margin:2px 0; min-width:1px; position:relative; }
.hist .bars span { position:absolute; left:calc(100% + 6px); top:-3px; font-size:11px; color:var(--muted); white-space:nowrap; }
.note { color:var(--muted); font-size:12px; margin:6px 0; }
.mono { font-family:ui-monospace,Menlo,Consolas,monospace; font-size:12px; }
.banner { padding:10px 14px; border-radius:8px; background:#3a331d; border:1px solid #5a4d2a; color:var(--warn); margin-bottom:14px; }
{{end}}
{{define "runbody"}}
<header>
  <h1>CSW load test &middot; {{.Meta.Label}}</h1>
  <div class="sub">Mimics the INSPIRE validator towards the NGR metadata service &middot; {{datetime .Meta.Started}} &middot; ran for {{.Duration}}</div>
</header>
<main>
{{if .Meta.Aborted}}<div class="banner">This run was interrupted before it completed; the numbers cover what was finished.</div>{{end}}

<h2>Run instance</h2>
<div class="grid">
  <div class="card"><div class="label">WAN IP</div><div class="value">{{.Meta.WANIP}}</div></div>
  <div class="card"><div class="label">Hostname</div><div class="value small">{{.Meta.Hostname}}</div></div>
  <div class="card"><div class="label">Run label</div><div class="value small">{{.Meta.Label}}</div></div>
  <div class="card"><div class="label">Services tested</div><div class="value">{{.Summary.ServicesSeen}} <span class="note">of {{.Meta.ServiceCount}}</span></div></div>
</div>

<h2>Result</h2>
<div class="grid">
  <div class="card"><div class="label">Requests</div><div class="value">{{.Summary.Overall.Count}}</div></div>
  <div class="card"><div class="label">Failed</div><div class="value {{rateClass .Summary.Overall.ErrorRate}}">{{.Summary.Overall.Errors}} <span class="note">({{pct .Summary.Overall.ErrorRate}})</span></div></div>
  <div class="card"><div class="label">Avg response</div><div class="value">{{ms .Summary.Overall.AvgMs}}</div></div>
  <div class="card"><div class="label">p95 response</div><div class="value">{{ms .Summary.Overall.P95Ms}}</div></div>
  <div class="card"><div class="label">p99 response</div><div class="value">{{ms .Summary.Overall.P99Ms}}</div></div>
  <div class="card"><div class="label">Achieved rate</div><div class="value">{{f2 .Summary.Overall.RequestsPS}} <span class="note">req/s</span></div></div>
</div>
<p class="note">Latency figures are computed over successful requests only; failures are counted separately. Failures include the full per-request timeout in their duration.</p>

<h2>Per host</h2>
{{template "stats" .Summary.ByHost}}

<h2>Per request type</h2>
{{template "stats" .Summary.ByKind}}

<h2>Per host and request type</h2>
{{template "stats" .Summary.ByHostKind}}

<h2>Where the time goes</h2>
<div class="scroll"><table>
<thead><tr><th>Host</th><th>DNS</th><th>TCP connect</th><th>TLS</th><th>Wait for first byte</th><th>Total</th><th>Avg body</th></tr></thead>
<tbody>{{range .Summary.ByHost}}<tr><td><span class="dot" style="background:{{color .Name}}"></span>{{.Name}}</td>
<td>{{ms .AvgDNSMs}}</td><td>{{ms .AvgConnMs}}</td><td>{{ms .AvgTLSMs}}</td><td>{{ms .AvgTTFBMs}}</td><td>{{ms .AvgMs}}</td><td>{{kb .AvgBytes}}</td></tr>{{end}}</tbody>
</table></div>
<p class="note">DNS/connect/TLS are only non-zero for requests on a new connection (use <code>--no-keep-alive</code> to measure them on every request).</p>

<h2>Timeline</h2>
<div class="legend">{{range .Legend}}<span><span class="dot" style="background:{{.Color}}"></span>{{.Name}}</span>{{end}}</div>
<div class="note">Average response time per {{.BucketSize}}</div>
<div class="chart">{{.LatencySVG}}</div>
<div class="note" style="margin-top:14px">Requests per {{.BucketSize}} (red = failed)</div>
<div class="chart">{{.CountSVG}}</div>

<h2>Response time distribution</h2>
<div class="legend">{{range .Legend}}<span><span class="dot" style="background:{{.Color}}"></span>{{.Name}}</span>{{end}}</div>
<div class="hist">
{{range .Hist}}<div class="row"><div>{{.Label}}</div><div class="bars">
{{range .Bars}}<div style="width:calc({{f1 .Pct}}% * 0.85);background:{{.Color}}"><span>{{.Count}}</span></div>{{end}}
</div></div>{{end}}
</div>

<h2>Failures</h2>
{{if not .Summary.Errors}}<p class="good">No failed requests.</p>{{else}}
<div class="grid">
{{range .Summary.ErrorsByCat}}<div class="card"><div class="label">{{.Name}}</div><div class="value bad">{{.Count}} <span class="note">({{pct .ErrorRate}})</span></div></div>{{end}}
</div>
<h2 style="font-size:15px">Why requests failed</h2>
<div class="scroll"><table>
<thead><tr><th class="l">Host</th><th class="l">Category</th><th class="l">Phase</th><th class="l">Reason</th><th>Count</th></tr></thead>
<tbody>{{range .Summary.Errors}}<tr><td class="l"><span class="dot" style="background:{{color .Host}}"></span>{{.Host}}</td><td class="l"><span class="pill">{{.Category}}</span></td><td class="l">{{.Phase}}</td><td class="wrap mono">{{.Message}}</td><td>{{.Count}}</td></tr>{{end}}</tbody>
</table></div>

<h2 style="font-size:15px">Failed requests</h2>
{{if .FailedNote}}<p class="note">{{.FailedNote}}</p>{{end}}
<div class="scroll"><table>
<thead><tr><th class="l">Time</th><th class="l">Host</th><th class="l">Type</th><th class="l">Record</th><th>Status</th><th>Duration</th><th class="l">Category</th><th class="l">Phase</th><th class="l">Error</th></tr></thead>
<tbody>{{range .Summary.Failed}}<tr><td class="l mono">{{ts .Time}}</td><td class="l"><span class="dot" style="background:{{color .Host}}"></span>{{.Host}}</td><td class="l">{{.Kind}}</td>
<td class="l mono">{{if .DatasetID}}{{.DatasetID}}{{else}}{{.ServiceID}}{{end}}</td><td>{{if .Status}}{{.Status}}{{else}}-{{end}}</td><td>{{ms .DurationMs}}</td>
<td class="l"><span class="pill">{{.ErrorCategory}}</span></td><td class="l">{{.ErrorPhase}}</td><td class="wrap mono">{{.Error}}</td></tr>{{end}}</tbody>
</table></div>
{{end}}

<h2>Remote IPs per host</h2>
{{template "stats" .Summary.ByRemoteIP}}
<p class="note">Shows which backend addresses answered; useful to spot a single bad node behind a hostname.</p>

<h2>Slowest successful requests</h2>
<div class="scroll"><table>
<thead><tr><th class="l">Time</th><th class="l">Host</th><th class="l">Type</th><th class="l">Record</th><th>Duration</th><th>TTFB</th><th class="l">Remote IP</th></tr></thead>
<tbody>{{range .Summary.Slowest}}<tr><td class="l mono">{{ts .Time}}</td><td class="l">{{.Host}}</td><td class="l">{{.Kind}}</td>
<td class="l mono">{{if .DatasetID}}{{.DatasetID}}{{else}}{{.ServiceID}}{{end}}</td><td>{{ms .DurationMs}}</td><td>{{ms .TTFBMs}}</td><td class="l mono">{{.RemoteIP}}</td></tr>{{end}}</tbody>
</table></div>

<h2>Configuration</h2>
<div class="scroll"><table>
<tbody>
<tr><td>Hosts</td><td class="l">{{range .Meta.Config.Hosts}}{{.}} {{end}}</td></tr>
<tr><td>Workers</td><td class="l">{{.Meta.Config.Workers}}</td></tr>
<tr><td>Requests per minute (total)</td><td class="l">{{if .Meta.Config.RequestsPerMinute}}{{.Meta.Config.RequestsPerMinute}}{{else}}unlimited{{end}}</td></tr>
<tr><td>Request timeout</td><td class="l">{{.Meta.Config.Timeout}}</td></tr>
<tr><td>Iterations</td><td class="l">{{if .Meta.Config.Iterations}}{{.Meta.Config.Iterations}}{{else}}until duration{{end}}</td></tr>
<tr><td>Max duration</td><td class="l">{{if .Meta.Config.Duration}}{{.Meta.Config.Duration}}{{else}}none{{end}}</td></tr>
<tr><td>Dataset requests</td><td class="l">{{.Meta.Config.IncludeDatasets}}{{if .Meta.Config.IncludeDatasets}} (max {{if .Meta.Config.MaxDatasetsPerService}}{{.Meta.Config.MaxDatasetsPerService}}{{else}}all{{end}} per service){{end}}</td></tr>
<tr><td>Keep-alive</td><td class="l">{{.Meta.Config.KeepAlive}}</td></tr>
<tr><td>Shuffle</td><td class="l">{{.Meta.Config.Shuffle}}</td></tr>
<tr><td>Service IDs</td><td class="l">{{.Meta.ServiceCount}} ({{if .Meta.IDsFromCache}}from cache{{else}}scraped from CSW{{end}})</td></tr>
<tr><td>Started</td><td class="l">{{datetime .Meta.Started}}</td></tr>
<tr><td>Finished</td><td class="l">{{datetime .Meta.Finished}}</td></tr>
</tbody></table></div>
</main>
{{end}}
